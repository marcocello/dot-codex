## From https://jasonstitt.com/gitignore-whitelisting-patterns

# 1. Ignore everything
*

# 2. But descend into directories
!/docs/
!/docs/**/

!/scripts/
!/integrations/
!/integrations/**/

!/skills/
!/skills/**/

# 3. Allow specific files and file extensions
!.gitignore
!AGENTS.md
!README.md
!install.sh
!env.sh
!config.template.toml
!pyproject.toml
!skills.toml

!/.vscode/
!/.vscode/tasks.json

!docs/**/*

!scripts/*.sh
!scripts/*.py
!integrations/**/*.json

!skills/**/*.html
!skills/**/*.py
!skills/**/*.yaml
!skills/**/*.md
!skills/**/*.sh
!skills/**/*.json
!skills/**/requirements.txt
!skills/**/LICENSE
!skills/**/assets/**

# 4. Block some directories and files
*.git
.DS_Store
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
node_modules/
build/
dist/
backups/
logs/
.env*
!skills/**/assets/**/.env.example

skills/.system/

# Generated verification runs and restored vendor fixtures stay local.
docs/**/runs/
docs/**/rounds/
docs/**/vendor/

# Keep history-filtered documents local.
/docs/artifacts/
/docs/reviews/
/docs/features/checkout-installer/
/docs/harness/coding/evaluations/

# Keep personal deliverables and runtime evidence outside public commits.
/docs/interactions/

# BEGIN skill_inventory.py managed skills
skills/reui/
# END skill_inventory.py managed skills
