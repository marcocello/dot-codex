{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup:env",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/setup.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "setup:backend",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--project",
        "app/backend",
        "--frozen"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "setup:frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/frontend",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "db",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "compose.yaml",
        "-f",
        "compose.dev.yaml",
        "up",
        "-d",
        "--wait",
        "db"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "setup"
      ]
    },
    {
      "label": "migrate",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "alembic",
        "upgrade",
        "head"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/backend",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "db"
      ]
    },
    {
      "label": "check:backend",
      "type": "process",
      "command": "bash",
      "args": [
        "pipelines/backend/check.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "check:frontend",
      "type": "process",
      "command": "bash",
      "args": [
        "pipelines/frontend/check.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "setup",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "setup:env",
        "setup:backend",
        "setup:frontend"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "dev:ready",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "migrate"
      ]
    },
    {
      "label": "backend:app",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/backend",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": {
        "owner": "local-run",
        "pattern": {
          "regexp": "^(?!)()(\\d+)()$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(?!)",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "dev:ready"
      ],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "frontend",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/frontend",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": {
        "owner": "local-run",
        "pattern": {
          "regexp": "^(?!)()(\\d+)()$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(?!)",
          "endsPattern": "Local:.*https?://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "dev:ready"
      ],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "test",
      "dependsOn": [
        "check:backend",
        "check:frontend"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "containers:up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build",
        "-d",
        "--wait"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "setup:env"
      ]
    },
    {
      "label": "containers:down",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "logs",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "logs",
        "--follow",
        "--tail=100"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "status",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "ps"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "smoke",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "python3 scripts/smoke.py \"http://127.0.0.1:${WEB_PORT:-8080}\""
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend",
      "dependsOn": [
        "backend:app"
      ],
      "problemMatcher": []
    },
    {
      "label": "fullstack",
      "dependsOn": [
        "frontend",
        "backend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
