{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "backend"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "backend"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "backend"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "backend",
            "image": "APP_BACKEND_IMAGE",
            "ports": [
              {
                "containerPort": 8000
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "app-secrets"
                }
              }
            ],
            "env": [
              {
                "name": "LOG_FORMAT",
                "value": "json"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/api/ready",
                "port": 8000
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/api/health",
                "port": 8000
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3
            },
            "startupProbe": {
              "httpGet": {
                "path": "/api/health",
                "port": 8000
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 30
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ],
        "automountServiceAccountToken": false
      }
    }
  }
}
