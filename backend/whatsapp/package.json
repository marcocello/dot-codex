{
  "name": "whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:environment": "node --import tsx scripts/check-environment.ts",
    "check": "npm run typecheck && npm run check:environment",
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
