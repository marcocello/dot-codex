# 1. Ignore everything.
*

# 2. Allow Git to descend into directories.
!*/

# 3. Allow the starter's source, configuration, and documentation.
!.gitignore
!.dockerignore
!.env.example
!.python-version
!.nvmrc
!*.md
!*.py
!*.toml
!*.lock
!*.ini
!*.mako
!*.ts
!*.tsx
!*.js
!*.mjs
!*.json
!*.html
!*.css
!*.svg
!*.png
!*.jpg
!*.jpeg
!*.webp
!*.ico
!*.woff
!*.woff2
!*.sh
!*.yaml
!*.yml
!Dockerfile
!Caddyfile
!Caddyfile.production

# 4. Block generated, local, secret, and runtime artifacts.
.git/
.venv/
node_modules/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
test-results/
playwright-report/
.cache/
.env
.env.*
!.env.example
*.pem
*.key
*.log
*.tsbuildinfo
*.sqlite
*.sqlite3
*.db
*.dump
.DS_Store
uploads/

backups/
logs/
