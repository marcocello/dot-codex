# Only source files belong in Git; Codex may write private runtime state here.
*
!.gitignore
!AGENTS.md
!README.md
!config.toml
!docs/
!docs/*.md
!docs/Pi-LICENSE.txt
!skills/
!skills/**/
!skills/**/*.md
!skills/**/*.py
!skills/**/*.yaml
!skills/**/*.yml
!skills/**/*.toml
!skills/**/*.lock
!skills/**/*.json
!skills/**/*.ts
!skills/**/*.tsx
!skills/**/*.css
!skills/**/*.html
!skills/**/Dockerfile
!skills/**/Makefile
!skills/**/Caddyfile
!skills/**/Caddyfile.production
!skills/**/alembic.ini
!skills/**/*.mako
!skills/**/.dockerignore
!skills/**/.env.example
!skills/**/.python-version
!skills/**/.nvmrc
skills/**/node_modules/
skills/**/.venv/
skills/**/__pycache__/
skills/**/.pytest_cache/
skills/**/.ruff_cache/
skills/**/dist/
skills/**/test-results/
skills/**/playwright-report/
skills/**/.env
skills/**/*.tsbuildinfo
