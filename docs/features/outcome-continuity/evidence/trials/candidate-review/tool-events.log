$ cat README.md presets.py test_presets.py
Run python3 test_presets.py to run the supplied checks. The CLI is the application entry point: python3 presets.py save NAME FILTER or python3 presets.py load NAME.
import sys
PRESETS = {}
def save(name, filters):
    PRESETS[name] = filters
def load(name):
    return PRESETS.get(name)
if __name__ == '__main__':
    command, name = sys.argv[1:3]
    if command == 'save':
        save(name, sys.argv[3])
        print('Saved ' + name)
    elif command == 'load':
        print(load(name))
import unittest
from presets import save, load
class PresetTests(unittest.TestCase):
    def test_roundtrip(self):
        save('weekly', 'last_7_days')
        self.assertEqual(load('weekly'), 'last_7_days')
if __name__ == '__main__':
    unittest.main()

