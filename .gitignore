## From https://jasonstitt.com/gitignore-whitelisting-patterns

# 1. Ignore everything
*

# 2. But descend into directories
!/docs/
!/docs/**/

!/scripts/

!/skills/
!/skills/**/

# 3. Allow specific files and file extensions
!.gitignore
!AGENTS.md
!README.md
!config.template.toml
!pyproject.toml
!skills.toml

!docs/**/*

!scripts/*.sh
!scripts/*.py

!skills/**/*.html
!skills/**/*.py
!skills/**/*.yaml
!skills/**/*.md
!skills/**/*.sh
!skills/**/*.json
!skills/**/requirements.txt
!skills/**/LICENSE
!skills/**/assets/**/*.js
!skills/**/assets/**/*.css
!skills/**/assets/**/*.png
!skills/**/assets/**/*.svg
!skills/**/assets/**/*.drawio

# 4. Block some directories and files
*.git
**/.venv/

skills/.system/

docs/features/**/proof/runs/**
docs/features/**/tests/runs/**
docs/interactions

# BEGIN skill_inventory.py managed skills
skills/bento-slides/
skills/reui/
# END skill_inventory.py managed skills
